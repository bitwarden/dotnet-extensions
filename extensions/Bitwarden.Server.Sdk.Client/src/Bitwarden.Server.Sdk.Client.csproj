<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PreReleaseVersionLabel>alpha</PreReleaseVersionLabel>
    <PreReleaseVersionIteration>1</PreReleaseVersionIteration>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' AND '$(IsPreRelease)' == 'true'">$(PreReleaseVersionLabel).$(PreReleaseVersionIteration)</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <Description>The calling side of a Bitwarden service: credentials, context, and failures.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host's environment decides whether the answer secret is required. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <!-- Reads the service-owned caches of the services a client calls. -->
    <PackageReference Include="StackExchange.Redis" Version="2.13.17" />
    <!-- Reads a cached answer into the generated client's type, which NSwag generates for Newtonsoft. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Bitwarden.Server.Sdk.Context\src\Bitwarden.Server.Sdk.Context.csproj" />
    <ProjectReference Include="..\..\Bitwarden.Server.Sdk.Errors\src\Bitwarden.Server.Sdk.Errors.csproj" />
    <ProjectReference Include="..\..\Bitwarden.Server.Sdk.Http\src\Bitwarden.Server.Sdk.Http.csproj" />
    <ProjectReference Include="..\..\Bitwarden.Server.Sdk.Idempotency.Abstractions\src\Bitwarden.Server.Sdk.Idempotency.Abstractions.csproj" />
    <ProjectReference Include="..\..\Bitwarden.Server.Sdk.Resources.Caching.Abstractions\src\Bitwarden.Server.Sdk.Resources.Caching.Abstractions.csproj" />
    <ProjectReference Include="..\..\Bitwarden.Server.Sdk.Sagas\src\Bitwarden.Server.Sdk.Sagas.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bitwarden.Server.Sdk.Client.Tests" />
    <!-- Its tests prove a cache owner's entries and a client's reads of them agree, end to end. -->
    <InternalsVisibleTo Include="Bitwarden.Server.Sdk.Resources.Caching.Tests" />
    <!-- A test double for a client uses up an OutgoingCall statement as ContextHandler does. -->
    <InternalsVisibleTo Include="Bitwarden.Server.Sdk.Client.Testing" />
  </ItemGroup>

</Project>
