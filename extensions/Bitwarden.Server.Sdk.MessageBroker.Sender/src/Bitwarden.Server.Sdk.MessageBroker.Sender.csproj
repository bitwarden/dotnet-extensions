<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PreReleaseVersionLabel>alpha</PreReleaseVersionLabel>
    <PreReleaseVersionIteration>1</PreReleaseVersionIteration>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' AND '$(IsPreRelease)' == 'true'">$(PreReleaseVersionLabel).$(PreReleaseVersionIteration)</VersionSuffix>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bitwarden.Server.Sdk.MessageBroker.Sender.Tests" />
    <!-- The test harness records what the dispatcher hands to the broker (IOutboxSendObserver). -->
    <InternalsVisibleTo Include="Bitwarden.Server.Sdk.Service.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Bitwarden.Server.Sdk.MessageBroker\src\Bitwarden.Server.Sdk.MessageBroker.csproj" />
  </ItemGroup>

</Project>
