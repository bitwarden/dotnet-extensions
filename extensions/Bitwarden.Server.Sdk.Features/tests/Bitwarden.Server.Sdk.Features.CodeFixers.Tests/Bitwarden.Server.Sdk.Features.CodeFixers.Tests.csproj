<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Bitwarden.Server.Sdk.Features.CodeFixers.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="[18.12.0]" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeRefactoring.Testing" Version="1.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="[3.2.2]" />
    <PackageReference Include="NSubstitute" Version="[6.2.0]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\analyzers\Bitwarden.Server.Sdk.Features.Analyzers\Bitwarden.Server.Sdk.Features.Analyzers.csproj" />
    <ProjectReference Include="..\..\analyzers\Bitwarden.Server.Sdk.Features.CodeFixers\Bitwarden.Server.Sdk.Features.CodeFixers.csproj" />
    <ProjectReference Include="..\..\src\Bitwarden.Server.Sdk.Features.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.CodeAnalysis.Analyzer.Testing 1.1.4 transitively references System.Security.Cryptography.Pkcs 9.0.6
      (via NuGet.Packaging), which is vulnerable to GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. Remove this reference
      once Microsoft.CodeAnalysis.*.Testing is updated to a version that no longer brings in a vulnerable version.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[10.0.13]" />
  </ItemGroup>

</Project>
