<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="[0.15.8]" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="[10.0.9]" />
    <PackageReference Include="Testcontainers" Version="[4.13.0]" />
  </ItemGroup>

  <ItemGroup>
    <!-- Force SSH.NET to 2026.0.0 to resolve GHSA-q939-rpr3-3284. Testcontainers 4.13.0
         still depends on the vulnerable 2025.1.0 transitively; this direct reference overrides
         it. Remove once Testcontainers ships a release that depends on 2026.0.0 or later. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bitwarden.Server.Sdk.MessageBroker.csproj" />
  </ItemGroup>

</Project>
