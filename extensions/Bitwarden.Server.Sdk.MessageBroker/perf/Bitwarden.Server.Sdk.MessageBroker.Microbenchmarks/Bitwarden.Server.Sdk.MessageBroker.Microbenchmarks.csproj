<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="[0.15.8]" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="[10.0.9]" />
    <PackageReference Include="Testcontainers" Version="[4.16.0]" />
  </ItemGroup>

  <ItemGroup>
    <!-- BenchmarkDotNet takes a version that has two CVEs so pin the transitive dependency higher
        until a version without it exists. -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="[3.2.8]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bitwarden.Server.Sdk.MessageBroker.csproj" />
  </ItemGroup>

</Project>
