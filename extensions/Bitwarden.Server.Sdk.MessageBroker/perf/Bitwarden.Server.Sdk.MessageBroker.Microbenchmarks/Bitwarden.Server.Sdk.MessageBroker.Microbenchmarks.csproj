<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="[0.15.8]" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="[10.0.9]" />
    <PackageReference Include="Testcontainers" Version="[4.13.0]" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testcontainers 4.13.0 transitively depends on SSH.NET 2025.1.0 (GHSA-q939-rpr3-3284).
         SSH.NET is not referenced directly. No patched version is available on NuGet yet;
         suppress until Testcontainers ships with a fixed dependency.
         TODO(2026-08-17): upgrade Testcontainers once it picks up SSH.NET 2026.0.0 or later. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-q939-rpr3-3284" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bitwarden.Server.Sdk.MessageBroker.csproj" />
  </ItemGroup>

</Project>
