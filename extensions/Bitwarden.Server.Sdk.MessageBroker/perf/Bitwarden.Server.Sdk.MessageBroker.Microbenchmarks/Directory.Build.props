<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    BenchmarkDotNet rebuilds the benchmark project in a temporary subdirectory of bin/ using
    an auto-generated .csproj called BenchmarkDotNet.Autogenerated.csproj. MSBuild's directory
    traversal finds this file first (before the repo root Directory.Build.props), so this file
    controls what settings that auto-generated project receives.

    Without this override, the root Directory.Build.props applies NuGet pack settings
    (GeneratePackageOnBuild, PackageReadmeFile, PACKAGE.md item) to BDN's auto-project, which
    then fails because PACKAGE.md does not exist in the temporary build directory.
  -->
  <PropertyGroup>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile />
  </PropertyGroup>

  <ItemGroup>
    <None Remove="PACKAGE.md" />
  </ItemGroup>
</Project>
