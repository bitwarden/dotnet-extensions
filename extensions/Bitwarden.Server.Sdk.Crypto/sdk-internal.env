# Pins the Rust side of this package. Bump together, then run scripts/fetch-native.sh and
# scripts/generate-bindings.sh, and commit the regenerated bindings.

# GitHub repository and the bitwarden-uniffi-server workflow building the native libraries.
SDK_INTERNAL_REPO=bitwarden/sdk-internal
SDK_INTERNAL_WORKFLOW=build-uniffi-server.yml

# sdk-internal commit whose SDK_INTERNAL_WORKFLOW build CI ships. Its latest successful run is
# used. Run artifacts expire, so a released package must be packed while that run is retained.
SDK_INTERNAL_COMMIT=fb9638bc56df29c921e439e436dbcdf5c9701155

# Must target the uniffi version pinned in sdk-internal (tag suffix `+vA.B.C`).
UNIFFI_BINDGEN_CS_TAG=v0.12.0+v0.32.0

# .NET runtime identifiers shipped in the NuGet package.
RIDS="linux-x64 linux-arm64 osx-arm64 win-x64"
