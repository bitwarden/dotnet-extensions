<Project Sdk="Microsoft.NET.Sdk">

  <!-- The service tests again, compiled without the request delegate generator the other suite
       uses, so the framework's runtime request delegate factory is covered as well. Every test
       passing both ways is the evidence that a handler under WithStandards() behaves alike on
       both of the framework's code paths. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bitwarden.Server.Sdk.Service.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The shared rate-limit counts' tests are left out: they map no handler, and need a Redis container. -->
  <ItemGroup>
    <Compile Include="..\Bitwarden.Server.Sdk.Service.Tests\**\*.cs"
             Exclude="..\Bitwarden.Server.Sdk.Service.Tests\obj\**;..\Bitwarden.Server.Sdk.Service.Tests\bin\**;..\Bitwarden.Server.Sdk.Service.Tests\Http\RateLimitCountersTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="[10.0.13]" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="[10.11.0]" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="[18.12.0]" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="[3.2.2]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bitwarden.Server.Sdk.Service.csproj" />
    <ProjectReference Include="..\..\..\Bitwarden.Server.Sdk.Client\src\Bitwarden.Server.Sdk.Client.csproj" />
  </ItemGroup>

</Project>
